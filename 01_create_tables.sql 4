-- 01_create_tables.sql

-- Clean old tables first, child to parent
DROP TABLE SCAN CASCADE CONSTRAINTS;
DROP TABLE PRODUCT CASCADE CONSTRAINTS;
DROP TABLE BRAND CASCADE CONSTRAINTS;
DROP TABLE MANUFACTURER CASCADE CONSTRAINTS;
DROP TABLE COUNTRY CASCADE CONSTRAINTS;

CREATE TABLE COUNTRY (
    country_code VARCHAR2(5) PRIMARY KEY,
    country_name VARCHAR2(100) NOT NULL UNIQUE,
    region VARCHAR2(100)
);

CREATE TABLE MANUFACTURER (
    manufacturer_id NUMBER(10) PRIMARY KEY,
    manufacturer_name VARCHAR2(100) NOT NULL UNIQUE,
    manufacturer_country VARCHAR2(5),
    CONSTRAINT fk_manufacturer_country
        FOREIGN KEY (manufacturer_country)
        REFERENCES COUNTRY(country_code)
        ON DELETE SET NULL
);

CREATE TABLE BRAND (
    brand_id NUMBER(10) PRIMARY KEY,
    brand_name VARCHAR2(100) NOT NULL UNIQUE,
    manufacturer_id NUMBER(10) NOT NULL,
    CONSTRAINT fk_brand_manufacturer
        FOREIGN KEY (manufacturer_id)
        REFERENCES MANUFACTURER(manufacturer_id)
        ON DELETE NO ACTION
);

CREATE TABLE PRODUCT (
    product_barcode VARCHAR2(50) PRIMARY KEY,
    product_label VARCHAR2(200) NOT NULL,
    product_size VARCHAR2(50),
    brand_id NUMBER(10) NOT NULL,
    bottle_weight NUMBER(10,2),
    CONSTRAINT fk_product_brand
        FOREIGN KEY (brand_id)
        REFERENCES BRAND(brand_id)
        ON DELETE NO ACTION,
    CONSTRAINT ck_bottle_weight
        CHECK (bottle_weight IS NULL OR bottle_weight > 0)
);

CREATE TABLE SCAN (
    scan_id NUMBER(10) PRIMARY KEY,
    product_barcode VARCHAR2(50) NOT NULL,
    scan_country VARCHAR2(5) NOT NULL,
    bottle_count NUMBER(10) NOT NULL,
    data_url VARCHAR2(500),
    CONSTRAINT fk_scan_product
        FOREIGN KEY (product_barcode)
        REFERENCES PRODUCT(product_barcode)
        ON DELETE CASCADE,
    CONSTRAINT fk_scan_country
        FOREIGN KEY (scan_country)
        REFERENCES COUNTRY(country_code)
        ON DELETE NO ACTION,
    CONSTRAINT ck_bottle_count
        CHECK (bottle_count > 0),
    CONSTRAINT uq_scan_product_country
        UNIQUE (product_barcode, scan_country)
);
